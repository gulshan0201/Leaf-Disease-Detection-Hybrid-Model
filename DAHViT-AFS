find the image folder (handles Kaggle nesting) -------------\n","def find_dir(root, name):\n","    for path, subdirs, _ in os.walk(root):\n","        for d in subdirs:\n","            if d.lower() == name:\n","                return os.path.join(path, d)\n","    raise FileNotFoundError(f\"'{name}' folder not found under {root}\")\n","\n","data_dir = find_dir(DATA_ROOT, VARIANT)\n","\n","# ---------------- data ----------------\n","train_tf = transforms.Compose([\n","    transforms.RandomResizedCrop(IMG_SIZE),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n","])\n","valid_tf = transforms.Compose([\n","    transforms.Resize(256),\n","    transforms.CenterCrop(IMG_SIZE),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n","])\n","\n","full_train = datasets.ImageFolder(data_dir, train_tf)\n","full_valid = datasets.ImageFolder(data_dir, valid_tf)\n","indices = list(range(len(full_train)))\n","random.Random(SEED).shuffle(indices)\n","cut = int((1 - VAL_SPLIT) * len(indices))\n","train_ds = Subset(full_train, indices[:cut])\n","valid_ds = Subset(full_valid, indices[cut:])\n","\n","train_dl = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True,  num_workers=4, pin_memory=True)\n","valid_dl = DataLoader(valid_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4, pin_memory=True)\n","classes  = full_train.classes\n","print(f\"Device: {DEVICE} | classes: {len(classes)} | \"\n","      f\"train: {len(train_ds)} | valid: {len(valid_ds)}\")\n","\n","# ---------------- model ----------------\n","class HybridCNNViT(nn.Module):\n","    def __init__(self, num_classes):\n","        super().__init__()\n","        self.cnn = timm.create_model(\"resnet50\", pretrained=True, num_classes=0)             # local features\n","        self.vit = timm.create_model(\"vit_small_patch16_224\", pretrained=True, num_classes=0)  # global features\n","        self.classifier = nn.Linear(self.cnn.num_features + self.vit.num_features, num_classes)\n","\n","    def forward(self, x):\n","        f_cnn = self.cnn(x)\n","        f_vit = self.vit(x)\n","        return self.classifier(torch.cat([f_cnn, f_vit], dim=1))\n","\n","model = HybridCNNViT(len(classes)).to(DEVICE)\n","\n","optimizer = torch.optim.AdamW(model.parameters(), lr=LR)\n","criterion = nn.CrossEntropyLoss()\n","scaler    = torch.amp.GradScaler(\"cuda\", enabled=USE_AMP)\n","\n","# ---------------- evaluation ----------------\n","def evaluate():\n","    model.eval()\n","    probs, trues = [], []\n","    with torch.no_grad():\n","        for x, y in valid_dl:\n","            with torch.amp.autocast(\"cuda\", enabled=USE_AMP):\n","                out = model(x.to(DEVICE))\n","            probs.append(torch.softmax(out.float(), 1).cpu().numpy())\n","            trues.append(y.numpy())\n","    probs = np.concatenate(probs); trues = np.concatenate(trues)\n","    preds = probs.argmax(1)\n","    return {\n","        \"accuracy\":  accuracy_score(trues, preds),\n","        \"precision\": precision_score(trues, preds, average=\"macro\", zero_division=0),\n","        \"recall\":    recall_score(trues, preds, average=\"macro\", zero_division=0),\n","        \"f1\":        f1_score(trues, preds, average=\"macro\", zero_division=0),\n","        \"auc\":       roc_auc_score(trues, probs, average=\"macro\", multi_class=\"ovr\"),\n","    }\n","\n","# ---------------- training ----------------\n","for epoch in range(1, EPOCHS + 1):\n","    model.train()\n","    total = 0.0\n","    for x, y in train_dl:\n","        x, y = x.to(DEVICE), y.to(DEVICE)\n","        optimizer.zero_grad()\n","        with torch.amp.autocast(\"cuda\", enabled=USE_AMP):\n","            loss = criterion(model(x), y)\n","        scaler.scale(loss).backward()\n","        scaler.step(optimizer)\n","        scaler.update()\n","        total += loss.item()\n","    m = evaluate()\n","    print(f\"epoch {epoch}/{EPOCHS}  loss {total/len(train_dl):.4f}  \"\n","          f\"acc {m['accuracy']:.4f}  f1 {m['f1']:.4f}\")\n","\n","# ---------------- final result ----------------\n","m = evaluate()\n","print(\"\\n=== Naive hybrid (CNN + ViT) on PlantVillage - final results ===\")\n","for k, v in m.items():\n","    print(f\"  {k:10s}: {v:.4f}\")\n","\n","torch.save(model.state_dict(), \"hybrid_plantvillage.pt\")\n","json.dump(classes, open(\"classes.json\", \"w\"))\n","print(\"\\nSaved model -> hybrid_plantvillage.pt\")"]},{"cell_type":"code","execution_count":5,"id":"6269298f","metadata":{"execution":{"iopub.execute_input":"2026-10-08T18:20:13.535955Z","iopub.status.busy":"2026-10-08T18:20:13.535673Z","iopub.status.idle":"2026-10-08T19:04:43.997024Z","shell.execute_reply":"2026-10-08T19:04:43.995887Z"},"papermill":{"duration":2670.467877,"end_time":"2026-10-08T19:04:43.998906+00:00","exception":false,"start_time":"2026-10-08T18:20:13.531029+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Device: cuda | classes: 38 | train: 43444 | valid: 10861\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"17b2d5e4389f4c66ab7876c5c86274e8","version_major":2,"version_minor":0},"text/plain":["model.safetensors:   0%|          | 0.00/114M [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Params: 53.1M\n","epoch 1/5  loss 0.3437  acc 0.9743  f1 0.9661\n","epoch 2/5  loss 0.1210  acc 0.9688  f1 0.9519\n","epoch 3/5  loss 0.0940  acc 0.9799  f1 0.9749\n","epoch 4/5  loss 0.0844  acc 0.9859  f1 0.9829\n","epoch 5/5  loss 0.0728  acc 0.9890  f1 0.9851\n","\n","=== DAHViT-AFS on PlantVillage - final results ===\n","  accuracy  : 0.9890\n","  precision : 0.9864\n","  recall    : 0.9844\n","  f1        : 0.9851\n","  auc       : 1.0000\n","\n","Saved model -> dahvit_afs_plantvillage.pt\n"]}],"source":["\"\"\"\n","DAHViT-AFS : Domain-Adaptive Hybrid ViT with Adaptive Feature Selection.\n","ResNet50 (local) + Swin-Tiny (global) branches, each projected to a common\n","dim, refined by per-branch Adaptive Feature Selection (channel + spatial\n","attention = \"select\"), then fused (\"fuse\") and classified.\n","Dataset: PlantVillage (color), 80/20 split. Reports Acc, Precision, Recall, F1, AUC.\n","\"\"\"\n","\n","import os, json, random\n","import numpy as np\n","import torch\n","import torch.nn as nn\n","import timm\n","from torch.utils.data import DataLoader, Subset\n","from torchvision import datasets, transforms\n","from sklearn.metrics import (accuracy_score, precision_score,\n","                             recall_score, f1_score, roc_auc_score)\n","\n","# ---------------- config ----------------\n","DATA_ROOT  = \"/kaggle/input/\"\n","VARIANT    = \"color\"\n","VAL_SPLIT  = 0.2\n","EPOCHS     = 5\n","BATCH_SIZE = 64\n","LR         = 3e-4\n","IMG_SIZE   = 224\n","EMBED_DIM  = 512\n","SEED       = 42\n","DEVICE     = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","USE_AMP    = (DEVICE == \"cuda\")\n","torch.backends.cudnn.benchmark = True\n","\n","# ------------- find the image folder -------------\n","def find_dir(root, name):\n","    for path, subdirs, _ in os.walk(root):\n","        for d in subdirs:\n","            if d.lower() == name:\n","                return os.path.join(path, d)\n","    raise FileNotFoundError(f\"'{name}' folder not found under {root}\")\n","\n","data_dir = find_dir(DATA_ROOT, VARIANT)\n","\n","# ---------------- data ----------------\n","train_tf = transforms.Compose([\n","    transforms.RandomResizedCrop(IMG_SIZE),\n","    transforms.RandomHorizontalFlip(),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n","])\n","valid_tf = transforms.Compose([\n","    transforms.Resize(256),\n","    transforms.CenterCrop(IMG_SIZE),\n","    transforms.ToTensor(),\n","    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n","])\n","\n","full_train = datasets.ImageFolder(data_dir, train_tf)\n","full_valid = datasets.ImageFolder(data_dir, valid_tf)\n","indices = list(range(len(full_train)))\n","random.Random(SEED).shuffle(indices)\n","cut = int((1 - VAL_SPLIT) * len(indices))\n","train_ds = Subset(full_train, indices[:cut])\n","valid_ds = Subset(full_valid, indices[cut:])\n","\n","train_dl = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True,  num_workers=4, pin_memory=True)\n","valid_dl = DataLoader(valid_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4, pin_memory=True)\n","classes  = full_train.classes\n","print(f\"Device: {DEVICE} | classes: {len(classes)} | \"\n","      f\"train: {len(train_ds)} | valid: {len(valid_ds)}\")\n","\n","# ---------------- Adaptive Feature Selection (per-branch) ----------------\n","class AFS(nn.Module):\n","    \"\"\"Channel attention + spatial attention -> selects informative features.\"\"\"\n","    def __init__(self, ch, reduction=16):\n","        super().__init__()\n","        self.channel = nn.Sequential(\n","            nn.AdaptiveAvgPool2d(1),\n","            nn.Conv2d(ch, ch // reduction, 1), nn.ReLU(inplace=True),\n","            nn.Conv2d(ch // reduction, ch, 1), nn.Sigmoid(),\n","        )\n","        self.spatial = nn.Sequential(\n","            nn.Conv2d(2, 1, kernel_size=7, padding=3), nn.Sigmoid(),\n","        )\n","\n","    def forward(self, x):\n","        x = x * self.channel(x)                               # channel selection\n","        avg = x.mean(1, keepdim=True)\n","        mx  = x.max(1, keepdim=True)[0]\n","        x = x * self.spatial(torch.cat([avg, mx], dim=1))     # spatial selection\n","        return x\n","\n","# ---------------- DAHViT-AFS model ----------------\n","class DAHViT_AFS(nn.Module):\n","    def __init__(self, num_classes, embed_dim=EMBED_DIM):\n","        super().__init__()\n","        self.cnn  = timm.create_model(\"resnet50\", pretrained=True, num_classes=0)\n","        self.swin = timm.create_model(\"swin_tiny_patch4_window7_224\", pretrained=True, num_classes=0)\n","        self.cnn_proj  = nn.Conv2d(self.cnn.num_features,  embed_dim, 1)   # 2048 -> 512\n","        self.swin_proj = nn.Conv2d(self.swin.num_features, embed_dim, 1)   # 768  -> 512\n","        self.afs_cnn  = AFS(embed_dim)        # select, per-branch\n","        self.afs_swin = AFS(embed_dim)\n","        self.fuse = nn.Sequential(            # then fuse\n","            nn.Conv2d(2 * embed_dim, embed_dim, 1),\n","            nn.BatchNorm2d(embed_dim), nn.ReLU(inplace=True),\n","        )\n","        self.classifier = nn.Linear(embed_dim, num_classes)\n","\n","    def fused_map(self, x):\n","        c = self.cnn.forward_features(x)                      # (B,2048,7,7)\n","        s = self.swin.forward_features(x)                     # (B,7,7,768) channels-last\n","        if s.dim() == 4 and s.shape[-1] == self.swin.num_features:\n","            s = s.permute(0, 3, 1, 2).contiguous()           # -> (B,768,7,7)\n","        c = self.afs_cnn(self.cnn_proj(c))                   # project + select\n","        s = self.afs_swin(self.swin_proj(s))\n","        return self.fuse(torch.cat([c, s], dim=1))           # fuse -> (B,512,7,7)\n","\n","    def forward(self, x):\n","        f = self.fused_map(x).mean(dim=(2, 3))               # global average pool\n","        return self.classifier(f)\n","\n","model     = DAHViT_AFS(len(classes)).to(DEVICE)\n","optimizer = torch.optim.AdamW(model.parameters(), lr=LR)\n","criterion = nn.CrossEntropyLoss()\n","scaler    = torch.amp.GradScaler(\"cuda\", enabled=USE_AMP)\n","print(f\"Params: {sum(p.numel() for p in model.parameters())/1e6:.1f}M\")\n","\n","# ---------------- evaluation ----------------\n","def evaluate():\n","    model.eval()\n","    probs, trues = [], []\n","    with torch.no_grad():\n","        for x, y in valid_dl:\n","            with torch.amp.autocast(\"cuda\", enabled=USE_AMP):\n","                out = model(x.to(DEVICE))\n","            probs.append(torch.softmax(out.float(), 1).cpu().numpy())\n","            trues.append(y.numpy())\n","    probs = np.concatenate(probs); trues = np.concatenate(trues)\n","    preds = probs.argmax(1)\n","    return {\n","        \"accuracy\":  accuracy_score(trues, preds),\n","        \"precision\": precision_score(trues, preds, average=\"macro\", zero_division=0),\n","        \"recall\":    recall_score(trues, preds, average=\"macro\", zero_division=0),\n","        \"f1\":        f1_score(trues, preds, average=\"macro\", zero_division=0),\n","        \"auc\":       roc_auc_score(trues, probs, average=\"macro\", multi_class=\"ovr\"),\n","    }\n","\n","# ---------------- training ----------------\n","for epoch in range(1, EPOCHS + 1):\n","    model.train()\n","    total = 0.0\n","    for x, y in train_dl:\n","        x, y = x.to(DEVICE), y.to(DEVICE)\n","        optimizer.zero_grad()\n","        with torch.amp.autocast(\"cuda\", enabled=USE_AMP):\n","            loss = criterion(model(x), y)\n","        scaler.scale(loss).backward()\n","        scaler.step(optimizer)\n","        scaler.update()\n","        total += loss.item()\n","    m = evaluate()\n","    print(f\"epoch {epoch}/{EPOCHS}  loss {total/len(train_dl):.4f}  \"\n","          f\"acc {m['accuracy']:.4f}  f1 {m['f1']:.4f}\")\n","\n","# ---------------- final result ----------------\n","m = evaluate()\n","print(\"\\n=== DAHViT-AFS on PlantVillage - final results ===\")\n","for k, v in m.items():\n","    print(f\"  {k:10s}: {v:.4f}\")\n","\n","torch.save(model.state_dict(), \"dahvit_afs_plantvillage.pt\")\n","json.dump(classes, open(\"classes.json\", \"w\"))\n","print(\"\\nSaved model -> dahvit_afs_plantvillage.pt\")"]},{"cell_type":"code","execution_count":6,"id":"b5fdfce7","metadata":{"execution":{"iopub.execute_input":"2026-10-08T19:04:44.009175Z","iopub.status.busy":"2026-10-08T19:04:44.00876Z","iopub.status.idle":"2026-10-08T20:42:22.621225Z","shell.execute_reply":"2026-10-08T20:42:22.620437Z"},"papermill":{"duration":5858.624582,"end_time":"2026-10-08T20:42:22.627717+00:00","exception":false,"start_time":"2026-10-08T19:04:44.003135+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Device: cuda | classes: 38 | valid images: 10861\n","\n","\n","### CNN (ResNet50)  |  clean acc = 0.9883\n","    blur        avg acc 0.8250   drop +0.1633\n","    noise       avg acc 0.5143   drop +0.4740\n","    brightness  avg acc 0.8511   drop +0.1372\n","    contrast    avg acc 0.6849   drop +0.3034\n","    occlusion   avg acc 0.9753   drop +0.0130\n","    OVERALL     corrupt 0.7701   mean drop +0.2182\n","\n","### ViT (ViT-Base)  |  clean acc = 0.9656\n","    blur        avg acc 0.8843   drop +0.0812\n","    noise       avg acc 0.7999   drop +0.1657\n","    brightness  avg acc 0.3881   drop +0.5774\n","    contrast    avg acc 0.3983   drop +0.5673\n","    occlusion   avg acc 0.9061   drop +0.0595\n","    OVERALL     corrupt 0.6753   mean drop +0.2902\n","\n","### Naive hybrid  |  clean acc = 0.9901\n","    blur        avg acc 0.9053   drop +0.0849\n","    noise       avg acc 0.7361   drop +0.2540\n","    brightness  avg acc 0.6996   drop +0.2905\n","    contrast    avg acc 0.7402   drop +0.2500\n","    occlusion   avg acc 0.9797   drop +0.0105\n","    OVERALL     corrupt 0.8122   mean drop +0.1780\n","\n","### DAHViT-AFS  |  clean acc = 0.9890\n","    blur        avg acc 0.8644   drop +0.1246\n","    noise       avg acc 0.5844   drop +0.4046\n","    brightness  avg acc 0.8004   drop +0.1886\n","    contrast    avg acc 0.6709   drop +0.3182\n","    occlusion   avg acc 0.9750   drop +0.0140\n","    OVERALL     corrupt 0.7790   mean drop +0.2100\n","\n","Saved -> robustness_results.json\n","\n","==================== ROBUSTNESS SUMMARY ====================\n","Model                Clean  Corrupt    Drop\n","CNN (ResNet50)      0.9883   0.7701  0.2182\n","ViT (ViT-Base)      0.9656   0.6753  0.2902\n","Naive hybrid        0.9901   0.8122  0.1780\n","DAHViT-AFS          0.9890   0.7790  0.2100\n","Lower Drop = more robust to lab->field shift.\n"]}],"source":["\"\"\"\n","STAGE 2 + 3 : Distribution-shift (lab -> field) robustness evaluation.\n","\n","Takes the trained model checkpoints and re-scores them on the SAME PlantVillage\n","validation split under FIELD-STYLE CORRUPTIONS at 3 severity levels:\n","  blur, noise, brightness, low-contrast, occlusion.\n","\n","For every model it reports clean accuracy, corrupted accuracy, and the DROP (Δ).\n","Smaller drop = more robust = better lab->field generalization. This is the\n","experiment that justifies the problem statement.\n","\n","Only checkpoints that exist are evaluated; missing ones are skipped.\n","\"\"\"\n","\n","import os, json, random\n","import numpy as np\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","import timm\n","from torch.utils.data import DataLoader, Subset\n","from torchvision import datasets, transforms\n","from sklearn.metrics import accuracy_score, f1_score\n","\n","# ---------------- config ----------------\n","DATA_ROOT  = \"/kaggle/input\"\n","VARIANT    = \"color\"\n","VAL_SPLIT  = 0.2\n","BATCH_SIZE = 64\n","IMG_SIZE   = 224\n","EMBED_DIM  = 512\n","SEED       = 42\n","DEVICE     = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","MEAN = torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)\n","STD  = torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)\n","\n","# checkpoints to look for: name -> (file, builder)\n","# builders rebuild each architecture so its saved weights can load.\n","def build_cnn(n):    return timm.create_model(\"resnet50\", pretrained=False, num_classes=n)\n","def build_vit(n):    return timm.create_model(\"vit_base_patch16_224\", pretrained=False, num_classes=n)\n","\n","class HybridCNNViT(nn.Module):\n","    def __init__(self, n):\n","        super().__init__()\n","        self.cnn = timm.create_model(\"resnet50\", pretrained=False, num_classes=0)\n","        self.vit = timm.create_model(\"vit_small_patch16_224\", pretrained=False, num_classes=0)\n","        self.classifier = nn.Linear(self.cnn.num_features + self.vit.num_features, n)\n","    def forward(self, x):\n","        return self.classifier(torch.cat([self.cnn(x), self.vit(x)], dim=1))\n","\n","class AFS(nn.Module):\n","    def __init__(self, ch, reduction=16):\n","        super().__init__()\n","        self.channel = nn.Sequential(\n","            nn.AdaptiveAvgPool2d(1),\n","            nn.Conv2d(ch, ch // reduction, 1), nn.ReLU(inplace=True),\n","            nn.Conv2d(ch // reduction, ch, 1), nn.Sigmoid())\n","        self.spatial = nn.Sequential(nn.Conv2d(2, 1, 7, padding=3), nn.Sigmoid())\n","    def forward(self, x):\n","        x = x * self.channel(x)\n","        avg = x.mean(1, keepdim=True); mx = x.max(1, keepdim=True)[0]\n","        return x * self.spatial(torch.cat([avg, mx], 1))\n","\n","class DAHViT_AFS(nn.Module):\n","    def __init__(self, n, embed_dim=EMBED_DIM):\n","        super().__init__()\n","        self.cnn  = timm.create_model(\"resnet50\", pretrained=False, num_classes=0)\n","        self.swin = timm.create_model(\"swin_tiny_patch4_window7_224\", pretrained=False, num_classes=0)\n","        self.cnn_proj  = nn.Conv2d(self.cnn.num_features,  embed_dim, 1)\n","        self.swin_proj = nn.Conv2d(self.swin.num_features, embed_dim, 1)\n","        self.afs_cnn = AFS(embed_dim); self.afs_swin = AFS(embed_dim)\n","        self.fuse = nn.Sequential(nn.Conv2d(2 * embed_dim, embed_dim, 1),\n","                                  nn.BatchNorm2d(embed_dim), nn.ReLU(inplace=True))\n","        self.classifier = nn.Linear(embed_dim, n)\n","    def forward(self, x):\n","        c = self.cnn.forward_features(x)\n","        s = self.swin.forward_features(x)\n","        if s.dim() == 4 and s.shape[-1] == self.swin.num_features:\n","            s = s.permute(0, 3, 1, 2).contiguous()\n","        c = self.afs_cnn(self.cnn_proj(c)); s = self.afs_swin(self.swin_proj(s))\n","        return self.classifier(self.fuse(torch.cat([c, s], 1)).mean(dim=(2, 3)))\n","\n","MODELS = {\n","    \"CNN (ResNet50)\":   (\"cnn_plantvillage.pt\",    build_cnn),\n","    \"ViT (ViT-Base)\":   (\"vit_plantvillage.pt\",    build_vit),\n","    \"Naive hybrid\":     (\"hybrid_plantvillage.pt\", HybridCNNViT),\n","    \"DAHViT-AFS\":       (\"dahvit_afs_plantvillage.pt\", DAHViT_AFS),\n","}\n","\n","# ---------------- corruptions (applied to a normalized batch's RAW pixels) ----\n","def _gauss_kernel(sigma, ch=3, device=\"cpu\"):\n","    k = int(2 * round(3 * sigma) + 1)\n","    ax = torch.arange(k) - k // 2\n","    g = torch.exp(-(ax ** 2) / (2 * sigma ** 2)); g = (g / g.sum()).to(device)\n","    return g, k\n","\n","def corrupt(x, kind, sev):\n","    \"\"\"x: raw pixels in [0,1], shape (B,3,H,W). Returns corrupted raw pixels.\"\"\"\n","    if kind == \"clean\":\n","        return x\n","    if kind == \"blur\":\n","        sigma = [0.0, 1.0, 2.0, 3.0][sev]\n","        g, k = _gauss_kernel(sigma, device=x.device)\n","        ker = (g[:, None] * g[None, :]).expand(3, 1, k, k)\n","        return F.conv2d(x, ker, padding=k // 2, groups=3).clamp(0, 1)\n","    if kind == \"noise\":\n","        std = [0.0, 0.05, 0.10, 0.20][sev]\n","        return (x + torch.randn_like(x) * std).clamp(0, 1)\n","    if kind == \"brightness\":\n","        delta = [0.0, 0.2, 0.4, 0.6][sev]\n","        return (x + delta).clamp(0, 1)\n","    if kind == \"contrast\":\n","        c = [1.0, 0.6, 0.4, 0.25][sev]\n","        mean = x.mean(dim=(2, 3), keepdim=True)\n","        return ((x - mean) * c + mean).clamp(0, 1)\n","    if kind == \"occlusion\":\n","        frac = [0.0, 0.2, 0.35, 0.5][sev]\n","        x = x.clone(); B, _, H, W = x.shape\n","        s = int(H * frac)\n","        if s > 0:\n","            for i in range(B):\n","                top = random.randint(0, H - s); left = random.randint(0, W - s)\n","                x[i, :, top:top + s, left:left + s] = 0.0\n","        return x\n","    raise ValueError(kind)\n","\n","# ---------------- data (raw pixels; normalize after corruption) -------------\n","def find_dir(root, name):\n","    for path, subdirs, _ in os.walk(root):\n","        for d in subdirs:\n","            if d.lower() == name:\n","                return os.path.join(path, d)\n","    raise FileNotFoundError(f\"'{name}' not found under {root}\")\n","\n","raw_tf = transforms.Compose([\n","    transforms.Resize(256), transforms.CenterCrop(IMG_SIZE), transforms.ToTensor()])\n","\n","def get_valid_loader():\n","    data_dir = find_dir(DATA_ROOT, VARIANT)\n","    ds = datasets.ImageFolder(data_dir, raw_tf)\n","    idx = list(range(len(ds))); random.Random(SEED).shuffle(idx)\n","    cut = int((1 - VAL_SPLIT) * len(idx))\n","    valid = Subset(ds, idx[cut:])\n","    return DataLoader(valid, batch_size=BATCH_SIZE, shuffle=False,\n","                      num_workers=4, pin_memory=True), ds.classes\n","\n","# ---------------- evaluation ------------------------------------------------\n","@torch.no_grad()\n","def score(model, loader, kind, sev):\n","    model.eval()\n","    mean, std = MEAN.to(DEVICE), STD.to(DEVICE)\n","    preds, trues = [], []\n","    for x, y in loader:\n","        x = x.to(DEVICE)\n","        x = corrupt(x, kind, sev)\n","        out = model((x - mean) / std)\n","        preds.append(out.argmax(1).cpu().numpy()); trues.append(y.numpy())\n","    preds = np.concatenate(preds); trues = np.concatenate(trues)\n","    return accuracy_score(trues, preds), f1_score(trues, preds, average=\"macro\", zero_division=0)\n","\n","def main():\n","    loader, classes = get_valid_loader()\n","    n = len(classes)\n","    print(f\"Device: {DEVICE} | classes: {n} | valid images: {len(loader.dataset)}\\n\")\n","\n","    corruptions = [\"blur\", \"noise\", \"brightness\", \"contrast\", \"occlusion\"]\n","    results = {}\n","\n","    for name, (ckpt, builder) in MODELS.items():\n","        if not os.path.exists(ckpt):\n","            print(f\"-- skipping {name}: {ckpt} not found\")\n","            continue\n","        model = builder(n).to(DEVICE)\n","        model.load_state_dict(torch.load(ckpt, map_location=DEVICE, weights_only=False))\n","        clean_acc, _ = score(model, loader, \"clean\", 0)\n","        print(f\"\\n### {name}  |  clean acc = {clean_acc:.4f}\")\n","        row = {\"clean\": clean_acc}\n","        for kind in corruptions:\n","            accs = [score(model, loader, kind, s)[0] for s in (1, 2, 3)]\n","            mean_acc = float(np.mean(accs))\n","            row[kind] = mean_acc\n","            print(f\"    {kind:11s} avg acc {mean_acc:.4f}   drop {clean_acc-mean_acc:+.4f}\")\n","        overall = float(np.mean([row[k] for k in corruptions]))\n","        row[\"corrupted_avg\"] = overall\n","        row[\"mean_drop\"] = clean_acc - overall\n","        print(f\"    {'OVERALL':11s} corrupt {overall:.4f}   mean drop {clean_acc-overall:+.4f}\")\n","        results[name] = row\n","        del model\n","        if DEVICE == \"cuda\":\n","            torch.cuda.empty_cache()\n","\n","    json.dump(results, open(\"robustness_results.json\", \"w\"), indent=2)\n","    print(\"\\nSaved -> robustness_results.json\")\n","\n","    # summary table\n","    if results:\n","        print(\"\\n==================== ROBUSTNESS SUMMARY ====================\")\n","        print(f\"{'Model':18s}{'Clean':>8s}{'Corrupt':>9s}{'Drop':>8s}\")\n","        for name, r in results.items():\n","            print(f\"{name:18s}{r['clean']:>8.4f}{r['corrupted_avg']:>9.4f}{r['mean_drop']:>8.4f}\")\n","        print(\"Lower Drop = more robust to lab->field shift.\")\n","\n","if __name__ == \"__main__\":\n","    main()"]}],"metadata":{"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":658267}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false},"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"